{"info":{"name":"Auto Setting Changer","description":"Loops over your alts and enable or disable a setting from /settings ","editedAt":1781459172593,"createdAt":1781458083018,"public":false,"language":"js","scriptType":"action","downloads":0,"theme":{"primaryColor":"#2193b0","secondaryColor":"#6dd5ed","accentColor":"#2193b0","gradientStart":"#2193b0","gradientEnd":"#6dd5ed","tagColor":"#6dd5ed"},"pluginId":"mqe25a6i6g7s0yt9li5","config":[{"name":"General","options":[{"id":"gamemode","label":"Gamemode","type":"gamemodeSelect","required":true,"defaultValue":"KitPvP"}],"collapsed":true},{"name":"Settings","options":[{"id":"command","label":"Command","type":"select","required":true,"valueByFieldId":"gamemode","options":[{"label":"/settings","value":"/settings"},{"label":"/options","value":"/options"}],"defaultValue":"/settings","freeSolo":true},{"id":"settingName","label":"Setting Name","type":"input","tooltip":"The item name of the setting item. For example 'kit voucher'","required":true,"valueByFieldId":"gamemode","inputType":"text","placeholder":"kit voucher","defaultValue":"kit voucher"},{"id":"toggleValue","label":"Toggle value","type":"select","tooltip":"Do you want to enable or disable the option?","required":true,"options":[{"label":"Enabled","value":"enabled"},{"label":"Disabled","value":"disabled"}],"defaultValue":"enabled","freeSolo":true}],"collapsed":false},{"name":"Alts","options":[{"id":"altrange","label":"Alt range","type":"altRange"},{"id":"withTags","label":"Alt group","type":"tagsSelect"},{"id":"ignoreAlts","label":"Skip alts","type":"altsSelect"}],"collapsed":false}]},"codeObf":"","signature":""}