{"format":"jnbot-plugin","version":2,"info":{"name":"Pearl puller","description":"Bot that detects and pulls your pearl when receiving a specific chat message. ","editedAt":null,"createdAt":1788970704026,"public":false,"language":"js","scriptType":"action","theme":{"primaryColor":"#2193b0","secondaryColor":"#6dd5ed","accentColor":"#2193b0","gradientStart":"#2193b0","gradientEnd":"#6dd5ed","tagColor":"#6dd5ed"},"pluginId":"mtuaytnbuvgekrljq88","config":[{"name":"General","options":[{"id":"alt","label":"Alt","type":"altSelect","tooltip":"The alt that joins to pull your pearl","required":true},{"id":"userWhitelist","label":"User whitelist","type":"altsSelect","tooltip":"These are the values '[username]' gets replaced with for matching the chat message.","required":true}],"collapsed":false},{"name":"Trigger","options":[{"id":"method","label":"Chat message method","type":"select","tooltip":"Start with: the message must start with a specific string.\nIncludes: The message must have a specific string inside of.","required":true,"options":[{"label":"Start with","value":"startWith"},{"label":"Includes","value":"includes"},{"label":"End with","value":"endsWith"}],"defaultValue":"includes"},{"id":"matchValue","label":"Match value","type":"input","tooltip":"This string must be matches with the chat message. `[username]` gets replaced with the whitelist username, so you should not replace it in this option.","required":true,"inputType":"text","placeholder":"String to match the chat message with","defaultValue":"[username]"}],"collapsed":true}],"banner":"https://i.ibb.co/QvNrXfP9/pearl-Puller.webp"},"codeObf":"","signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"JNbot Official","signedAt":"2026-09-09T19:26:48.471Z","value":"9JHqsCz6mRCWLhWnW_aRC6xtanBb6wFnxZ-k9oknKaHKO5Pr_NByK_vY7HntQL3pD37Zb788YP7LdGTRocNwCg"}}