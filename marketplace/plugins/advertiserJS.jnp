{"code":{"code":"\n\nconst USERNAME = script.settings?.username || \"Zola\"\nconst GAMEMODE = script.settings?.gamemode ||\"gens\"\n\nconst ADVERTISE_MESSAGES = [\n    [script.settings?.advertiseMessage1 ||\"\", script.settings?.advertiseMessage2 || \"\"], // Could be [\"Message 1\"] if you only want 1 message to be sent\n]\n\n\nconst MINUTES_15 = 1000 * 60 * (parseInt(script.settings?.interval) || 15)\n\n\nnew BotStatemachine(\n    null,\n    [\n        {\n            name: 'advertising',\n            action: async (bot, targets) => {\n                targets.last_advertised = Date.now()\n                const msg = ADVERTISE_MESSAGES[targets.advertise_counter]\n                if (msg[0]) bot.chat(msg[0])\n                await bot.waitForTicks(1)\n                if (msg[1]) bot.chat(msg[1])\n                targets.advertise_counter = (targets.advertise_counter + 1) % ADVERTISE_MESSAGES.length\n            },\n            shouldTrigger: (_, targets) => Date.now() - targets.last_advertised > MINUTES_15,\n        },\n    ],\n    {\n        targets: {\n            alt: {\n                username: USERNAME,\n                version: \"1.20.4\",\n                host: \"jartex.fun\"\n\n            },\n            joinOptions: {\n                gamemode: GAMEMODE,\n                login: true,\n            },\n            last_advertised: Date.now(),\n            advertise_counter: 0\n        },\n        extensions: {\n            joinGm: true,\n            joinServer: true,\n        },\n        stopOnIdle: false,\n        delay: 4000,\n    }\n).start();\n"},"format":"jnbot-plugin","info":{"_id":{},"banner":"https://i.ibb.co/WWGYR2S0/Chat-GPT-Image-29-mei-2025-18-26-54.png","config":[{"collapsed":false,"name":"General","options":[{"id":"username","label":"Username","tooltip":"The account that will be used to advertise","type":"altSelect"},{"gamemodes":["SkyblockDream","SkyblockFantasy","Factions Immortal","Prison","Survival","KitPvP","Lifesteal","Oneblock"],"id":"gamemode","label":"Gamemode","type":"gamemodeSelect"},{"id":"advertiseMessage1","label":"Advertise message 1","type":"input"},{"id":"advertiseMessage2","label":"Advertise message 2","tooltip":"This is optional, if you add a second message, then the bot will send 2 messages at the same time.","type":"input"},{"id":"interval","inputType":"number","label":"Interval (in minutes)","tooltip":"Send the advertise message every x minutes. Note: in jartex it is not allowed to set this lower than 15 minutes!!!","type":"input"}]}],"createdAt":1715378530126,"description":"Sends a message every 15min","editedAt":null,"flags":8,"language":"js","name":"advertiser","pluginId":"advertiserJS","privateKey":"nfdxm9s2ejh41foj3onx20rvjfnv0uyils64ffxpx4","public":false,"publicKey":"advertiserJS","settings":{"advertiseMessage1":"","interval":"15","username":"Zola"},"theme":{"accentColor":"#4a148c","gradientEnd":"#ba68c8","gradientStart":"#8a2be2","primaryColor":"#8a2be2","secondaryColor":"#ba68c8","tagColor":"default"},"type":"verified","uploadedAt":1715378530126,"userID":"40179c160fc4d12b5490a3d048d471f50b25946dd40a019fdb15f2bf7512ff30"},"signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"usserwout","signedAt":"2026-09-03T13:32:51.654Z","value":"dCPVvbsrjo7c33Qj3sh597xFaksf399dZwZxpIq0bMnwBZHM_3HnNTA3wkV3axzicF27PoQayJvP3LxNw8yJDg"},"version":2}
