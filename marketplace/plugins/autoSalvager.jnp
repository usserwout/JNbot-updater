{"code":{"code":"\nconst {script} = require(\"jnbot\")\n/**\n * What does this script do?\n * 1) It joins KitPvP with your alt.\n * 2) It opens /gift window and collects gifts until the inventory is full\n * 3) It trashes the items that cannot salvage (like golden_apple etc). These items are specified in `ITEMS_TO_TRASH` variable\n * 4) The bot opens the /salvage and salvages all the items.\n * 5) Repeat until no gifts are left. \n * \n */\n\nconst USERNAME = script.settings?.username \n\nconst configSlotId = parseInt(script.settings?.salvageAcceptSlot)\nconst SALVAGE_ACCEPT_SLOT = isNaN(configSlotId) ?  49 : configSlotId // [!!!] JARTEX USERS:  Change this to 0 for jartex kitpvp [!!!]\n\nconst ITEMS_TO_TRASH = script.settings?.itemsToTrash ?? [\"cooked_beef\", \"potion\", \"arrows\", \"carrot\", \"golden_carrot\",\"fishing_rod\"] // if set to `[]` then it will not trash anything. You can add or remove items, make sure to use the official item name.\nconst ITEMS_TO_GIFT = script.settings?.itemsToGift ?? [\"golden_apple\"]\nconst TRANSFER_ITEMS_TO = script.settings?.transferToUsername\n// BEFORE YOU RUN THE SCRIPT:\n// - Make sure that there are no items that cannot be salvaged in the inventory or gifts\n// \n\n\n// ---------------------------------------------------------- \\\\\n\n\n\nconst items_to_trash_set = new Set(ITEMS_TO_TRASH)\nconst items_to_gift_set = new Set(ITEMS_TO_GIFT)\n\nif (ITEMS_TO_GIFT.length > 0 && !TRANSFER_ITEMS_TO) {\n    console.error(\"You no account set to transfer gifts to. Ignoring items to gift.\")\n    items_to_gift_set.clear()\n}\n\nfunction getEmptyInventorySlotsCount(bot) {\n    let win = bot.currentWindow ?? bot.inventory\n\n    return win.slots.slice(win.inventoryStart).reduce((a, b) => a + (b ? 0 : 1), 0)\n}\n\nasync function main() {\n    const botStatemachine = new BotStatemachine(\n        null,\n        [\n            {\n                name: \"Salvaging items\",\n                shouldTrigger: (bot) => bot.currentWindow && bot.getWindowTitle().toLowerCase().includes(\"salvage\"),\n                action: async (bot) => {\n                    const w = bot.currentWindow\n                    for (let i = w.inventoryStart; i < w.inventoryEnd; i++) {\n                        if (w.slots[i] && bot.currentWindow) {\n                            bot.clickWindow(i, 0, 0)\n                            await bot.waitForTicks(1)\n                        }\n                    }\n\n                    bot.clickWindow(SALVAGE_ACCEPT_SLOT, 0, 0) // click on salvage accept slot \n                    await bot.waitForTicks(10)\n                }\n            },\n\n            {\n                name: \"Getting gifts\",\n                shouldTrigger: (bot) => bot.currentWindow && bot.getWindowTitle().toLowerCase().includes(\"your deliveries\"),\n                action: async (bot) => {\n                    let i = 0;\n                    let hasClicked = false\n                    while (bot.currentWindow && getEmptyInventorySlotsCount(bot) > 5 && i < bot.currentWindow.inventoryStart) {\n                        const slot = bot.currentWindow.slots[i]\n                        i++\n                        if (!slot || i%9 === 0 || slot.name !== \"chest\") continue\n                        bot.clickWindow(i, 0, 0)\n                        hasClicked = true\n                        await bot.waitForTicks(5)\n                    }\n\n                    if (bot.currentWindow) {\n                        bot.closeWindow(bot.currentWindow)\n                        await bot.waitForTicks(1)\n                    }\n\n                    if (!hasClicked) {\n                        console.success(\"Finished! Opened all gifts\")\n                        botStatemachine.stop()\n                        bot.end()\n                        script.stop()\n                    }\n                }\n            },\n            {\n                name: \"Opening gift window\",\n                shouldTrigger: (bot) => !bot.currentWindow && bot.inventory.slots.slice(bot.inventory.inventoryStart).every(e => e === null), // No items in inventory\n                action: async (bot) => {\n                    await bot.openWindow(\"/gift\", { ticks: 40 })\n                    if (!bot.currentWindow) {\n                        // Failed to open window, no gifts left\n                        console.success(\"Finished! Opened all gifts\")\n                        botStatemachine.stop()\n                        bot.end()\n                        script.stop()\n                    }\n                }\n            },\n            {\n                name: \"Trashing non salvagable items\",\n                shouldTrigger: (bot) => !bot.currentWindow && bot.inventory.slots.slice(bot.inventory.inventoryStart).some(e => e && items_to_trash_set.has(e.name)),\n                action: async (bot) => {\n                    await bot.transferItems.trash({ filter: ITEMS_TO_TRASH })\n                    if(bot.currentWindow) {\n                        bot.closeWindow(bot.currentWindow)\n                        await bot.waitForTicks(2)\n                    }\n                }\n            },\n            {\n                name: \"Gifting non salvagable items\",\n                shouldTrigger: (bot) => !bot.currentWindow && bot.inventory.slots.slice(bot.inventory.inventoryStart).some(e => e && items_to_gift_set.has(e.name)),\n                action: async (bot) => {\n                    await bot.transferItems.gift({ filter: ITEMS_TO_GIFT, username:TRANSFER_ITEMS_TO })\n              \n                }\n            },\n            {\n                name: \"Opening salvage window\",\n                shouldTrigger: (bot) => !bot.currentWindow && bot.inventory.slots.slice(bot.inventory.inventoryStart).some(e => e), // has item to salvage\n                action: async (bot) => {\n                    await bot.openWindow(\"/salvage\")\n                }\n            },\n\n            {\n                name: \"Idling...\",\n                shouldTrigger: () => true,\n                action: async () => {\n                    console.log(\"This should never happen...\")\n                }\n            }\n\n        ], {\n        targets: {\n            alt: {\n                username: USERNAME,\n            },\n            joinOptions: {\n                gamemode: \"kitpvp\",\n                login: true,\n            },\n            extensions: {\n                joinGm: true,\n                joinServer: true,\n            },\n        }\n    }\n    ).start();\n}\n\n\n\nmain()"},"format":"jnbot-plugin","info":{"_id":{},"banner":"https://i.ibb.co/9mjLKDXK/Chat-GPT-Image-30-mei-2025-00-17-20.png","config":[{"collapsed":false,"name":"General","options":[{"id":"username","label":"Username","required":true,"type":"altSelect"},{"defaultValue":49,"id":"salvageAcceptSlot","inputType":"number","label":"SlotID the bot needs to click on (default=49)","required":true,"tooltip":"This is the slot ID of the slot the bot needs to click on to finish the salvaging.","type":"input"},{"defaultValue":["potion","cooked_beef","golden_apple","arrows","golden_carrot","fishing_rod","carrot"],"freeSolo":true,"id":"itemsToTrash","label":"Items to trash","options":["golden_apple","cooked_beef","potion","arrows","carrot","golden_carrot","fishing_rod"],"tooltip":"The bot will trash these items. Make sure you use the official item names.","type":"multiSelect"},{"defaultValue":["golden_apple"],"freeSolo":true,"id":"itemsToGift","label":"Items to gift","options":["golden_apple"],"tooltip":"Unsalvageable items that you do not want to trash","type":"multiSelect"},{"id":"transferToUsername","label":"Gift items to ","tooltip":"","type":"altSelect"}]}],"createdAt":1737382529040,"description":"Opens gifts and /salvage all the armor, sword, ... (KitPvP) ","editedAt":null,"flags":4,"language":"js","name":"auto_salvager","pluginId":"autoSalvager","privateKey":"wiuhal0nvvqokkkse4lVkhmjtqg99fstrrjbief49as","public":false,"publicKey":"autoSalvager","scriptType":"script","settings":{"itemsToGift":["golden_apple"],"itemsToTrash":["cooked_beef","potion","arrow","carrot","golden_carrot","fishing_rod"],"salvageAcceptSlot":"49","transferToUsername":"usserwout","username":"Zola"},"theme":{"accentColor":"#d6a962","gradientEnd":"#de7166","gradientStart":"#d7d158","primaryColor":"#d7d158","secondaryColor":"#de7166","tagColor":"default"},"type":"verified","uploadedAt":null,"userID":"40179c160fc4d12b5490a3d048d471f50b25946dd40a019fdb15f2bf7512ff30"},"signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"usserwout","signedAt":"2026-09-03T13:32:51.657Z","value":"c0TSYhQJHK3LCa9MWI1_0KULxLfLAW4FjbRlf_L3TF8xoQcAw109Bv4BR_ADclmdz_13YnPxBYpp34-rziqWBg"},"version":2}
