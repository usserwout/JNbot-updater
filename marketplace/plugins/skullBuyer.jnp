{"code":{"code":"/**\n * What does this script do?\n * 1) joins prison with ALTS\n * 2) opens /g shop and starts buying `SKULL_NAME`\n * 3) When bot has no money, it redeems banknotes\n * \n */\n\nconst { script, BotMachine } = require(\"jnbot\")\n\n// ############################ Options #################################\n\nconst ALTS = [\"Zola\"]              // Alts to join with\nlet SKULL_NAME = \"Ancient King\"    // Skull slot\nconst DELAY_CLICK = 1              // Delay between 2 clicks (in ticks)\nconst ITEM_SLOT = 17               // The slot id that the bot repeatedly clicks on  \n\n// ######################################################################\n\n\nSKULL_NAME = SKULL_NAME.toLowerCase()\n\nconst __a = Array(250).fill(0)\nlet i = 0\nfor (let alt of ALTS) {\n  main(alt, i++)\n  await sleep(5000)\n}\n\n\n\n\nfunction findSlotId(name, bot) {\n  if (!bot.currentWindow) return\n  for (let i = 0; i < bot.currentWindow.inventoryStart; i++) {\n    const slot = bot.currentWindow.slots[i]\n    if (!slot) continue\n    const info = bot.itemInfo(slot)\n    if (info.name.toLowerCase().includes(name)) return i\n  }\n  return null\n}\n\n\nfunction main(username) {\n  new BotMachine([\n    {\n      name: \"Setting up listener\",\n      when: () => true,\n      once: true,\n      run: ({ bot, state }) => {\n        bot.on(\"messagestr\", (u) => {\n          if (u.startsWith('(!) You do not have enough money. You need')) {\n            state.noMoney = true;\n          }\n        })\n\n      }\n    },\n    {\n      name: \"Redeeming more money\",\n      when: ({ state }) => state.noMoney,\n      run: async ({ bot, state }) => {\n        const worked = await redeemBanknote(bot)\n        if (!worked) {\n          console.log(\"Failed to redeem money, exiting.\")\n          script.stop()\n          return\n        }\n        state.noMoney = false\n      }\n    },\n    {\n      name: \"opening gshop\",\n      when: ({ bot }) => !bot.currentWindow,\n      run: ({ bot }) => bot.openWindow(\"/gang shop\")\n    },\n    {\n      name: \"Click on g shop skull\",\n      when: ({ bot }) => bot.getWindowTitle().toLowerCase().includes(\" shop\"),\n      run: async ({ bot }) => {\n        const slotId = findSlotId(SKULL_NAME, bot)\n        if (!slotId) {\n          console.error(\"No slot found with name \" + SKULL_NAME + \". Double check if such skull exists in g shop.\")\n          script.stop()\n          return\n        }\n        bot.clickWindow(slotId, 0, 0)\n        await bot.waitForTicks(10)\n      }\n    },\n    {\n      name: \"Clicking on skull\",\n      when: () => true,\n      run: async ({ bot }) => {\n        for (let i = 0; i < 10; i++) {\n          if (!bot.currentWindow) break\n          bot.clickWindow(ITEM_SLOT, 0, 0)\n          await bot.waitForTicks(DELAY_CLICK)\n        }\n      }\n    }\n  ], {\n    join: {\n      gamemode: \"prison\"\n    },\n    options: {\n      username,\n      version: \"1.8.9\",\n\n    }\n  }\n  ).start()\n\n}\n\n\n\n\n\nfunction sleep(x) {\n  return new Promise((r) => setTimeout(r, x))\n}\n\nasync function redeemBanknote(bot) {\n  if (bot.currentWindow) {\n    bot.closeWindow(bot.currentWindow)\n    await bot.waitForTicks(20)\n  }\n  if (bot.currentWindow) {\n    bot.closeWindow(bot.currentWindow)\n    await bot.waitForTicks(20)\n  }\n  if (bot.currentWindow) bot.closeWindow(bot.currentWindow)\n  bot.setQuickBarSlot(0)\n  await bot.waitForTicks(10)\n\n  if (bot.currentWindow) {\n    console.log(bot.username + \": window is not closing! if this keep happening, please contact usserwout\")\n    return await redeemBanknote()\n  }\n  const banknote = bot.inventory.items().find(e => e.name === \"paper\")\n  if (!banknote) {\n    return console.log(bot.username + \": Unable to find any banknotes!!!\")\n  }\n  try {\n    //await equipItem(banknote)\n    await bot.equip(banknote, 'hand')\n    bot.activateItem()\n    await bot.waitForTicks(2)\n    //bot.deactivateItem()\n    await sleep(1000)\n    noMoney = false\n    return true\n  } catch (e) {\n    console.log(e)\n  }\n  return false\n}"},"format":"jnbot-plugin","info":{"banner":"","createdAt":1678363994674,"description":"bot buys skulls in prison and redeems banknotes","editedAt":null,"language":"js","name":"skull_buyer","pluginId":"skullBuyer","public":false,"scriptType":"script","theme":{"accentColor":"#f90b7a","primaryColor":"#1a515e","secondaryColor":"#232323"}},"signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"usserwout","signedAt":"2026-08-30T15:53:50.018Z","value":"fUcYZNKoR5B7J6UDeHju_oq5rVKsYiJhp0bkQZlxOqAADKHtaws5XRj7Y6KEWJid3hiAe1PDjMSz-H7tWQjjAQ"},"version":2}
