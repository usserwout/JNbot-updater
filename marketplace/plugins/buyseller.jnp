{"code":{"code":"/**\n * With this script, you can join a selected gamemode and automate the process of purchasing\n * a specific item until your inventory is full. Then, it will sell all of the items for you.\n */\n\n\n/**\n * BEFORE YOU RUN THIS SCRIPT:\n * - Your alt must have an empty inventory\n * - Your alt cannot contain a server selector clock (/settings to remove it)\n * - Your alt must have money to buy/sell the items\n * - Change configuration\n * - Make sure the selected item is sellable\n */\n\n\n// ---------------------------- OPTIONS ---------------------------- \\\\\n\n\n\nconst USERNAME = \"Zola\" // alt username\nconst GAMEMODE = \"sbd\"\n\nconst SHOP_CATEGORY = \"mob drops\".toLowerCase() // the name of the /shop category (item name) eg: \"mob drops\" or \"custom crops\" (ignore .lowerCase() part)\nconst ITEM_NAME = \"steak\".toLowerCase() // Name of the item you want to buy/sell (eg. \"lemon seeds\" or \"steak\")\n\nconst DELAY = 5 // In ticks (20 ticks = 1 sec) between each action\n\n// Optional\nconst SHOP_TITLE = \"Jartex Shop\" // This is the title of the window when you type /shop\nconst SHOP_PREFIX = \"Shop - \" // This is the prefix of the title of the window when go to a category\nconst SHOP_ITEM_PREFIX = \"Buying \" // The prefix of window title when you left-click on an item\nconst BUY_MORE_ITEM_SLOT = 31 // The container that says 'buy more'\nconst BUY_36_STACKS_SLOT = 22 // Buy 36 stacks at the same time item slot\n\n// ---------------------------- END OPTIONS ---------------------------- \\\\\n\n\n\n new BotStatemachine(null, [\n  {\n    name: \"Opening shop window\",\n    shouldTrigger: (bot) => !bot.currentWindow,\n    action: async (bot) => {\n      await bot.openWindow(\"/shop\")\n    }\n  },\n  {\n    name: \"Opening shop category\",\n    shouldTrigger: (bot) => bot.currentWindow.title.includes(SHOP_TITLE),\n    action: async (bot) => {\n      const slot = findSlot(SHOP_CATEGORY, bot)\n      if (!slot) {\n        console.log(\"Could not find \" + SHOP_CATEGORY + \" category!\")\n        await bot.waitForTicks(20)\n        return\n      }\n      bot.clickWindow(slot.slot, 0, 0)\n    }\n  },\n  {\n    name: \"Buy selling...\",\n    shouldTrigger: (bot) => bot.currentWindow.title.replace(/\"/g, \"\").startsWith(SHOP_PREFIX),\n    action: async (bot) => {\n      const slot = findSlot(ITEM_NAME, bot)\n      if (!slot) {\n        console.log(\"Could not find \" + SHOP_CATEGORY + \" category!\")\n        return\n      }\n\n      if (bot.inventory.slots.at(-1) === null) {\n        // Buy items\n        bot.clickWindow(slot.slot, 0, 0)\n        console.log(\"Clicking on \" + ITEM_NAME)\n      } else {\n        // Sell items\n        console.log(\"Selling items\")\n        bot.clickWindow(slot.slot, 1, 0)\n       \n      }\n    },\n  },\n  {\n    name:\"Selling\",\n    shouldTrigger: (bot) => bot.currentWindow.title.replace(/\"/g, \"\").startsWith(\"Selling \"),\n     action: (bot) => {\n      bot.clickWindow(BUY_36_STACKS_SLOT, 0, 0)\n     }\n  },\n  {\n    name: \"Buying stacks\",\n    shouldTrigger: (bot) => bot.currentWindow.title.replace(/\"/g, \"\").startsWith(SHOP_PREFIX),\n    action: (bot) => {\n      if (bot.currentWindow.title.includes(\" stacks \")) {\n        // Buy stacks\n        bot.clickWindow(BUY_36_STACKS_SLOT, 0, 0)\n        console.log(\"Buying item...\")\n      } else {\n        // Click on the container\n        bot.clickWindow(BUY_MORE_ITEM_SLOT, 0, 0)\n      }\n    }\n  },\n  {\n    name: \"Clicking on buying more\",\n    shouldTrigger: (bot) => bot.currentWindow.title.replace(/\"/g, \"\").startsWith(SHOP_ITEM_PREFIX),\n    action: (bot) => {\n      if (bot.currentWindow.title.includes(\" stacks \")) {\n        // Buy stacks\n        bot.clickWindow(BUY_36_STACKS_SLOT, 0, 0)\n        console.log(\"Buying item...\")\n      } else {\n        // Click on the container\n        bot.clickWindow(BUY_MORE_ITEM_SLOT, 0, 0)\n      }\n    }\n  },\n  {\n    name: \"Idle\",\n    shouldTrigger: () => true,\n    action: () => console.log(\"Idling...\")\n  }\n], {\n  targets: {\n    alt: {\n      username: USERNAME,\n    },\n    joinOptions: {\n      gamemode: GAMEMODE,\n      login: true,\n    },\n    extensions: {\n      joinGm: true,\n      joinServer: true,\n    },\n  }\n}\n).start()\n\nfunction findSlot(name, bot) {\n  return (bot.currentWindow?.slots ?? []).find(slot => {\n    if (!slot) return false\n    return (slot.displayName.toLowerCase() === name\n      || bot.itemInfo(slot).name.toLowerCase().replace(/§./g, '').includes(name)\n    )\n  })\n}\n"},"format":"jnbot-plugin","info":{"_id":{},"createdAt":1675013459923,"description":"Buy and sell an item for level","editedAt":null,"flags":4,"language":"js","name":"shop-buy-sell","pluginId":"buyseller","privateKey":"pwezm3kefka32eqbydkmae42nviq3ip8vutbbhat9d2","public":false,"publicKey":"buyseller","type":"verified","uploadedAt":1675013459923,"userID":"40179c160fc4d12b5490a3d048d471f50b25946dd40a019fdb15f2bf7512ff30"},"signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"usserwout","signedAt":"2026-09-03T13:32:51.660Z","value":"C8fJSJCOCZ-nxDrsKayTf5LXpxIp1YqVFANGMJV_fG8hDu3r8smbYuJZUbPRudmaCLYG5Kltn0tZLkfMW2D2DQ"},"version":2}
