{"code":{"code":"\n/**\n * This plugin runs a script (like \"gkit collector\" or \"kit collector\") in an interval of x hours. \n * Useful for collecting kits with a cooldown of 1 hour \n * Note: change the settings by clicking on the plugin > setting, do not change the code!\n */\n\nconst SCRIPT = script.settings?.script || \"mpqqzf5mlsgzkgxyk7d\"\n\nconst INTERVAL =  60_000  * (parseInt(script.settings?.inverval) || 61)    // = 1hour and 1 minute |  Run script every hour\n                                 // It's better to make it a little bit longer than the cooldown to ensure the cooldown has finished.\n\nconst RUN_ON_START = script.settings?.runOnStart ??  true        // Run the script as soon as you start the plugin (if set to false, the script runs after INTERVAL ms)\n\nconst LOG_INTERVAL =  60_000 * (parseInt(script.settings?.logInterval) || 5)  // Log a message containing when the next run will be (default 5 min)\n\n\n\n// *************************************************************************************** \\\\\n\n\nfunction run() {\n  console.log(\"======================= Running: \" + SCRIPT + \" =======================\")\n  script.stopPlugin({\n    pluginId: SCRIPT\n  })\n\n\n  script.startPlugin({\n    pluginId: SCRIPT,                                   // Start plugin by plugin name\n  })\n\n}\n\nsetInterval(run, INTERVAL)\nrun()\n\n\nlet count = 0\n\nif(LOG_INTERVAL > 1000) setInterval(() => {\n  count++\n  const t = INTERVAL - LOG_INTERVAL * count\n  if (t <= 0) return count = 0\n  console.log(Math.floor(t / 60_000) + \" minutes before next collect\")\n}, LOG_INTERVAL) // Show a log message when the next collect will be (default every 5min)\n"},"format":"jnbot-plugin","info":{"_id":{},"banner":"https://i.ibb.co/cXgnKDPm/Chat-GPT-Image-29-mei-2025-18-26-57.png","config":[{"collapsed":false,"name":"General","options":[{"clearable":false,"defaultValue":"mpqqzf5mlsgzkgxyk7d","freeSolo":true,"id":"script","label":"Script","options":[{"label":"kit collector","value":"mpqqzf5mlsgzkgxyk7d"},{"label":"gkit collector","value":"mpojb0gpxnn024s3i2"}],"required":true,"tooltip":"The script that will be activated every x minutes","type":"select"},{"defaultValue":61,"id":"inverval","inputType":"number","label":"Interval (in minutes)","required":true,"tooltip":"The amount of minutes before running the script again","type":"input"},{"defaultValue":true,"id":"runOnStart","label":"Run the script when plugin starts","labelChecked":"Run plugin on start","type":"switch"},{"defaultValue":15,"id":"logInterval","label":"Log interval (in minutes)","max":60,"min":5,"step":5,"tooltip":"Send a log message every x minutes that tells you when the next collect is going to be.","type":"slider"}]}],"createdAt":1722797029157,"description":"Auto start a script like kit collector every x hours","editedAt":null,"flags":0,"language":"js","name":"scriptRunner","pluginId":"scriptRunner","privateKey":"nfdxm9s2ejh42aoj3onx20rvjfnv0uyils64ffxpx4","public":false,"publicKey":"scriptRunner","settings":{"inverval":"61","logInterval":5,"runOnStart":true,"script":"kit collector"},"theme":{"accentColor":"#3c7e6b","primaryColor":"#58a5a7","secondaryColor":"#2d604d"},"type":"verified","uploadedAt":1722797029157,"userID":"40179c160fc4d12b5490a3d048d471f50b25946dd40a019fdb15f2bf7512ff30"},"signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"usserwout","signedAt":"2026-09-03T13:32:51.670Z","value":"_pbc1QouGkslQ_dzdTIwRj6kpPOdMY94ISROdtvAiBu7n1uFQbEE866czpQpejR64Ugj3t7G9nA4SaPRbxIKAg"},"version":2}
