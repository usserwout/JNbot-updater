{"code":{"code":"\n/**\n * **** Auto level up alts for prison ****\n * \n * The script will do the following:\n * 1. Joins server with first alt of ALTS array\n * 2. Alt goes to prison gamemode\n * 3. Alt waits until you pay him money (this step will get skipped if your alt already has money)\n * 4. Your alt will start sending /rankup until it doesn't have enough money\n * 5. Alt collects the rewards (from /gift) and gifts them to your main account  \n * 6. Next alt joins (back to 1.)\n */\n\n// These alts must be in your alt list\nconst ALTS = [\n  \"Zola\",\n  \"Zoli\",\n] // replace with `script.getAlts().map(a => a.username)` for all alts\n\nconst USERNAME = \"usserwout\" // The account other alts will gift to\n\n\nconst DELAY_BETWEEN_MESSAGES = 30 // 20 ticks (= 1 sec)\nconst RANKUP_COMMAND = '/rankup'  // Command to rankup alts\nconst SERVER_GIFT_SLOT = 13       // \n\n/*  -------------------------------- end config -------------------------------  */\n\nmain()\nasync function main(){\n  for await (const alt of ALTS) {\n    await run(alt)\n  }\n  script.stop()\n}\n\nfunction run(username) {\n  return new Promise(async (resolve) => {\n    let bot\n    let done = false\n    let receivedMoney = false\n    let finished = false\n\n    const actions = [\n      [() => !bot, joinServer, 'Joining server with ' + username],\n      [() => !bot.getGamemode()?.toLowerCase()?.includes(\"prison\"), () => bot.join(\"prison\"), 'Joining prison...'],\n      [() => !receivedMoney && Object.values(bot.scoreboard?.sidebar?.itemsMap??{}).some(c => c?.displayName?.toString().trim() === \"Balance: $0\") , ()=> ({}), 'Waiting for money... ('+ username +')'],\n      [() => !done, sendRankupMessage, 'Wrote ' + RANKUP_COMMAND],\n      [() => !bot.currentWindow, () => bot.openWindow(\"/gift\"), \"Opening gifting window\"],\n      [() => bot.currentWindow.title === '\"Your Deliveries\"', () => bot.clickWindow(SERVER_GIFT_SLOT, 0, 0), \"Opening server deliveries\"],\n      [() => bot.currentWindow.title === '\"Your Deliveries \"', clickOnGift, \"Clicking on gift slot\"],\n\n    ]\n\n    async function clickOnGift() {\n      // 1. Get slot\n      let slot = null\n      for (let i = 0; i < bot.currentWindow.inventoryStart; i++) {\n        const s = bot.currentWindow.slots[i]\n        if (s && s.name === \"chest\") {\n          slot = s\n          break;\n        }\n      }\n      if (slot === null) {\n        finish()\n        return\n      }\n      bot.clickWindow(slot.slot, 0, 0)\n    }\n\n    async function joinServer() {\n      bot = await join({ username }, { gamemode: \"prison\", login: true })\n      bot.on(\"messagestr\", (msg) => {\n        if (msg.includes('You do not have enough cash or beacons to afford a rankup.')) {\n          done = true\n          console.log(\"Finished ranking up\")\n        } else if (done && msg.startsWith('(!) You do not have any deliveries.')) {\n          finish()\n        }\n      })\n      bot.once(\"end\", () => bot = null)\n    }\n\n    async function finish() {\n      finished = true\n      \n      console.log(\"Redeemed all gifts\")\n      resolve()\n      await bot.transferItems(2,{username:USERNAME,ignore:['clock']}) \n      bot.end()\n    }\n\n    async function sendRankupMessage() {\n      receivedMoney = true\n      bot.chat(RANKUP_COMMAND)\n      await bot.waitForTicks(DELAY_BETWEEN_MESSAGES)\n    }\n\n\n    while (!finished) {\n      const action = actions.find((a) => a[0]())\n      if (action) {\n        console.log(action[2])\n        await action[1]()\n      } else console.log(\"Idling...\")\n      await sleep(250)\n    }\n  })\n}\n\nfunction sleep(x) {\n  return new Promise((r) => setTimeout(r, x))\n}\n\n"},"format":"jnbot-plugin","info":{"_id":{},"createdAt":1676476104214,"description":"Ranks up your alts on prison and gifts the items to your account","editedAt":null,"flags":4,"language":"js","name":"auto-prison-rankup","pluginId":"autorankup","privateKey":"wiuhal0nvvqokkkse4lvkhmjtqg99fstrrjbief49as","public":false,"publicKey":"autorankup","type":"verified","uploadedAt":1677096106507,"userID":"40179c160fc4d12b5490a3d048d471f50b25946dd40a019fdb15f2bf7512ff30"},"signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"usserwout","signedAt":"2026-09-03T13:32:51.659Z","value":"xy8DycyUYt0Uzk25Y0rHwh3Lm6qfH1jYHl8kTUc1AVMMLZ7_ilgVbdHZE6uXZTujyOAbUhVqgLyKyvkMXlLFAg"},"version":2}
