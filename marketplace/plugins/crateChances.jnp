me: '+1% Prestige Price', chance: 3 },\n      { name: '+2% Prestige Price', chance: 2 },\n      { name: '+3% Prestige Price', chance: 1 },\n      { name: 'Vote Sword', chance: 50 },\n      { name: 'Vote Axe', chance: 50 },\n      { name: 'Vote Armor Set ', chance: 50 },\n      { name: 'Thug Kit Voucher', chance: 50 },\n      { name: 'Criminal Kit Voucher', chance: 30 },\n      { name: '+250 Experience', chance: 15 },\n      { name: '+350 Experience', chance: 10 },\n      { name: 'Voteparty Collector Voucher', chance: 3 },\n      { name: 'Enchanted Golden Apple (x2)', chance: 5 },\n      { name: 'Item Rename (Right Click)', chance: 30 },\n      { name: 'Basic Voting Pickaxe', chance: 50 },\n      { name: 'Advanced Voting Pickaxe', chance: 30 },\n      { name: '+10 Minutes of autominer time', chance: 1.5 },\n      { name: '+15 Minutes of autominer time', chance: 0.5 },\n      { name: 'Workbench Command Voucher', chance: 2 },\n      { name: 'Nick Command Voucher', chance: 2 },\n      { name: 'Feed Command Voucher', chance: 2 },\n      { name: 'Hat Command Voucher', chance: 2 },\n      { name: 'Mystery CrateKey Crate', chance: 0.25 },\n      { name: 'Tokens Bowl', chance: 5 },\n      { name: 'Money Pot', chance: 5 },\n      { name: 'Pet Experience', chance: 30 },\n      { name: 'Mystery Bombs Box', chance: 20 },\n      { name: 'Rare Crate Key ALL', chance: 0.5 },\n      { name: 'Rare Crate (x2)', chance: 0.75 },\n      { name: 'Ultra Crate', chance: 0.5 },\n      { name: 'Pet Experience', chance: 15 },\n      { name: 'Seasonal Thug Rank Voucher ', chance: 0.5 },\n      { name: 'Seasonal Criminal Rank Voucher ', chance: 0.25 }\n    ]}\n  }\n}\n\n// ----------------------------- \\\\\n\n// Some validation ...\nif (!(GAMEMODE in crate_data)) {\n  console.error(\"GAMEMODE must be one of: \"+ Object.keys(crate_data).join(\", \"))\n  script.stop()\n}\n// More validation ...\nif (!(CRATE in crate_data[GAMEMODE])) {\n  console.error(\"CRATE must be one of: \"+ Object.keys(crate_data[GAMEMODE]).join(\", \"))\n  script.stop()\n}\n\n// Let's sort the rewards based on their chance\nconst data = crate_data[GAMEMODE][CRATE].rewards.sort((a,b) => {\n  if(b.chance === a.chance) {\n    return b.name.localeCompare(a.name)\n  }\n  return b.chance - a.chance\n})\n\n// We first calculate the sum of the chances (weights)\nconst sumOfWeight = data.reduce((a,b) => a + b.chance,0)\nlet list = [] // Used this to create the tabel on the jartex post \n// For each item we calculate the chance of winning that item\nfor(const item of data) {\n  const chance_to_win_item = item.chance/sumOfWeight\n  const average_amount_of_keys_needed_to_win_item = 1 / chance_to_win_item\n  const costPrice = Math.round(crate_data[GAMEMODE][CRATE].gold * GOLD_TO_MONEY_CONVERSION * average_amount_of_keys_needed_to_win_item*100)/100\n  \n  const avgProcentage = chance_to_win_item < 0.01 ? Math.round(chance_to_win_item*100000)/1000 : Math.round(chance_to_win_item*10000)/100 \n  const amountOfKeysCeiled = Math.ceil(average_amount_of_keys_needed_to_win_item)\n  console.log(`> '${item.name}' has a ${avgProcentage}% win chance. You need on average ${amountOfKeysCeiled} keys to win this item, which will cost you on average €${costPrice}.`)\n  list.push([item.name,avgProcentage,amountOfKeysCeiled,costPrice ])\n}\n//console.log(JSON.stringify(list))\n\n// We can also simulate opening a crate\nconst rand = Math.random() * sumOfWeight\nlet count = 0\nlet i = 0\nwhile(count < sumOfWeight) {\n  count += data[i].chance\n  if(count > rand) {\n    console.log(`[SIMULATION]: You won ${data[i].name} from opening ${CRATE}`)\n    break;\n  }\n  i++\n}\n\nscript.stop()\n"},"format":"jnbot-plugin","info":{"_id":{},"createdAt":1702678186286,"description":"Calculates the chance to win x from crate y. (see console for result)","editedAt":null,"flags":8,"language":"js","name":"Crate_stats","pluginId":"crateChances","privateKey":"pwezm3kefka32eqbydkmae42nviq3ip8vutbbhat9d2","public":false,"publicKey":"crateChances","type":"verified","uploadedAt":1702678186286,"userID":"40179c160fc4d12b5490a3d048d471f50b25946dd40a019fdb15f2bf7512ff30"},"signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"usserwout","signedAt":"2026-09-03T13:32:51.663Z","value":"WLWAGaDKAQhsOXkP0ddfIr252ZmxrmwFGcAdVMD-nc8dO9C6aO03iItVXLo6ld2J6DwGE5wLhyjzjLdD4UL9Aw"},"version":2}
