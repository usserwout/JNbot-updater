{"code":{"code":"// This script removes all the items from your inventory and disables the server \n// selector clock in your settings\n\n\n// This script only works with jnbot version 1.8.1 or above\n/************************************** OPTIONS **************************************/\n\nlet GAMEMODE = script.settings?.gamemode || \"sbd\"                                        // eg. 'skyblockdream', 'skyblockfantasy', 'factions immortal', 'prison', ....\nconst IGNORE_ALTS = script.settings?.ignoreAlts ?? [\"usserwout\"]                           // Accounts you don't want the script to clear your inventory\nconst REMOVE_CLOCK = script.settings?.removeClock ?? false                                  // Remove clock from inventory\nconst SKIP_ALTS_WITHOUT_GKIT = script.settings?.skipAltsWithoutGkit ?? false                        // if 'true': ignore alts that have no gkits \nconst SKIP_ALTS_WITHOUT_RANK = script.settings?.skipAltsWithoutRank ?? false                        // if 'true': ignore alts that have no rank \nconst MENU_SETTING_NAME = (script.settings?.menuSettingName ||\"menu in inventory\").toLowerCase() // Name of the 'menu in inventory' setting in /settings\nconst START_WITH =script.settings?.startWith || null                                     // replace null with \"Zola\" if you want to start with your alt named Zola\nconst USE_CLEAR_INVENTORY_COMMAND = script.settings?.useClearInventoryCommand ?? true                    //  false -> uses /trash   |  true -> uses '/ci' (clear inventory) command \n\n/*************************************************************************************/\n\nGAMEMODE = GAMEMODE.toLowerCase()\nlet alts = script.getAlts()\nif (START_WITH) {\n  const idx = alts.findIndex((e) => e.username === START_WITH)\n  alts = alts.slice(idx)\n}\n\nfor await (let alt of alts) {\n  if (IGNORE_ALTS.includes(alt.username)) continue\n  if (SKIP_ALTS_WITHOUT_GKIT && (alt.gkits?.[GAMEMODE] ?? []).length === 0) {\n    console.log(\"Skipping \" + alt.username + \" because alt doesn't have gkits in \" + GAMEMODE)\n    continue\n  }\n  if (SKIP_ALTS_WITHOUT_RANK && alt.ranks?.[GAMEMODE]) {\n    console.log(\"Skipping \" + alt.username + \" because alt doesn't have a rank in \" + GAMEMODE)\n    continue\n  }\n  console.log(\"Joining with \" + alt.username)\n  await main(alt)\n}\nscript.stop()\n\nfunction main(alt) {\n  return new Promise((resolve) => {\n    const stateMachine = new BotStatemachine(null, [\n      {\n        name: \"Disabling the menu in inventory setting\",\n        shouldTrigger: (bot) => REMOVE_CLOCK && bot.currentWindow && bot.currentWindow.title.includes(\"Settings\"),\n        action: async (bot, targets) => {\n          const slot = bot.currentWindow.slots.find(slot => slot && bot.itemInfo(slot).name.toLowerCase().includes(\"menu in inventory\"))\n          if (!slot) {\n            console.log(\"Failed to find the 'menu in inventory' setting in /settings. To fix this, update `MENU_SETTING_NAME` option.\")\n            return\n          }\n          const nbtData = bot.itemInfo(slot)\n\n          if (nbtData.info.includes(\"Current state: §c✖\")) {\n            console.log(\"Menu setting is already disabled\")\n            return\n          }\n          bot.clickWindow(slot.slot, 0, 0)\n          targets.has_disabled_clock = true\n          await bot.waitForTicks(5)\n          if (bot?.currentWindow) {\n            bot.closeWindow(bot.currentWindow)\n            await bot.waitForTicks(10)\n          }\n        }\n      },\n      {\n        name: \"Closing incorrect window\",\n        shouldTrigger: (bot) => !!bot.currentWindow,\n        action: async (bot) => {\n          console.log(\"Window opened: \" + bot.currentWindow.title)\n          bot.closeWindow(bot.currentWindow)\n          await bot.waitForTicks(10)\n        }\n      },\n      {\n        name: \"Opening /settings window\",\n        shouldTrigger: (bot) => REMOVE_CLOCK && bot.inventory.slots.find(item => item && item.name === \"clock\"),\n        action: async (bot) => {\n          console.log(\"Sending /settings\")\n          bot.chat(\"/settings\")\n          await bot.waitForTicks(10)\n        }\n      },\n      {\n        name: \"Clearing inventory\",\n        shouldTrigger: (bot) => bot.inventory.slots.slice(bot.inventory.inventoryStart).some(item => item && item.name !== \"clock\"),\n        action: async (bot) => {\n          console.log(\"Opening trash window\")\n          if (USE_CLEAR_INVENTORY_COMMAND) {\n            await bot.openWindow(\"/ci\")\n            await bot.waitForTicks(5)\n            bot.clickWindow(11, 0, 0)\n          } else {\n            await bot.transferItems(3, { ignore: [\"clock\"], command: \"/trash\" })\n          }\n          await bot.waitForTicks(10)\n        }\n      },\n      {\n        name: \"Finished clearing inventory with \" + alt.username,\n        shouldTrigger: () => true,\n        action: (bot) => {\n          stateMachine.stop()\n          bot.end()\n          resolve()\n        }\n      }\n    ], {\n      targets: {\n        has_disabled_clock: false,\n        alt,\n        joinOptions: {\n          gamemode: GAMEMODE\n        },\n      },\n      extentions: {\n        joinServer: true,\n        joinGm: true\n      },\n      stopOnIdle: true,\n      debug: true,\n    }).start()\n\n  })\n}\n\n\n\n\n\n\n"},"format":"jnbot-plugin","info":{"_id":{},"banner":"https://i.ibb.co/LF7WXHj/Chat-GPT-Image-29-mei-2025-18-26-52.png","config":[{"collapsed":false,"name":"General","options":[{"gamemodes":["SkyblockDream","SkyblockFantasy","Factions Immortal","Prison","Survival","KitPvP","Lifesteal","Oneblock"],"id":"gamemode","label":"Gamemode","type":"gamemodeSelect"},{"id":"removeClock","label":"Remove clock","labelChecked":"Remove clock","labelUnchecked":"Keep clock","type":"switch"},{"id":"menuSettingName","label":"Name of the menu in the inventory","type":"input"},{"id":"useClearInventoryCommand","label":"Use clear inventory command","type":"switch"}]},{"collapsed":true,"name":"Select alts","options":[{"id":"startWith","label":"Start with alt","type":"altSelect"},{"id":"ignoreAlts","label":"Ignore alts","tooltip":"","type":"altsSelect"},{"id":"skipAltsWithoutGkits","label":"Skip alts without gkits","labelChecked":"","labelUnchecked":"","type":"switch"},{"id":"skipAltsWithoutRank","label":"Skip alts without ranks","type":"switch"}]}],"createdAt":1680509653441,"description":"Clear the inventory of your alts and remove the server selector clock.","editedAt":null,"flags":8,"language":"js","name":"clear_inventory","pluginId":"clearInventoryScript","privateKey":"wiuhal0nvvqokkkse4lVkhmjtqg99fstrrjbief49as","public":false,"publicKey":"clearInventoryScript","settings":{"gamemode":"SkyblockDream","ignoreAlts":["Zoli","Zola"],"removeClock":false,"startWith":"gnembon_mc","useClearInventoryCommand":false},"theme":{"accentColor":"#8a8aff","gradientEnd":"#1e8da3","gradientStart":"#9b5edc","primaryColor":"#9b5edc","secondaryColor":"#1e8da3","tagColor":"default"},"type":"verified","uploadedAt":1680509653441,"userID":"40179c160fc4d12b5490a3d048d471f50b25946dd40a019fdb15f2bf7512ff30"},"signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"usserwout","signedAt":"2026-09-03T13:32:51.661Z","value":"ZoF1IsNmIL2c0NZD9KqNiQYnfIlrpQ-pWHYGZ2aQkFJe6YBFNpa6U91ZsiAl3w08g8aSy17SZyA4lSDXnT-qCA"},"version":2}
