{"code":{"code":"\nconst { script, BotMachine } = require(\"jnbot\")\n\n\nconst USERNAME = script.settings.username\nconst START_PV = Number.parseInt(script.settings.startPv)\nconst GAMEMODE = script.settings.gamemode\n\nconst DELIVERIES_WINDOW_SLOT = Number.parseInt(script.settings.clickGiftSlotId)  // When gift menu is opened, Which section should it go to?  \nconst AT_LEAST_K_EMPTY_SLOTS = Number.parseInt(script.settings.leastEmptySlots)\n\n/// ----------------- \\\\\\\n\n\nfunction hasNearFullInventory(bot) {\n  const window = bot.currentWindow ?? bot.inventory\n  let emptySlotCount = 0\n  for (let i = window.inventoryStart; i < window.inventoryEnd; i++) {\n    if (window.slots[i] === null) {\n      emptySlotCount++\n    }\n  }\n  return AT_LEAST_K_EMPTY_SLOTS > emptySlotCount\n}\n\nnew BotMachine([\n  {\n    name: \"Opening pv\",\n    when: ({ bot }) => hasNearFullInventory(bot),\n    run: async ({ bot, state }) => {\n      if (bot.currentWindow) {\n        bot.closeWindow(bot.currentWindow)\n        await bot.waitForTicks(5)\n      }\n      await bot.transferItems.window({ command: \"/pv \" + state.pv })\n      if (bot.currentWindow) bot.closeWindow(bot.currentWindow)\n      const window = bot.currentWindow ?? bot.inventory\n      for (let i = window.inventoryStart; i < window.inventoryEnd; i++) {\n        if (window.slots[i]) {\n          state.pv++\n          break;\n        }\n      }\n    }\n  },\n  {\n    name: \"Open gifts\",\n    when: ({ bot }) => !bot.currentWindow,\n    run: async ({ bot }) => {\n      await bot.openWindow(\"/gift\")\n    }\n  },\n  {\n    name: \"Clicking on deliveries\",\n    when: ({ bot }) => bot.currentWindow.title.toLowerCase().includes('deliveries'),\n    run: ({ bot }) => {\n      bot.clickWindow(DELIVERIES_WINDOW_SLOT, 0, 0)\n    }\n  },\n  {\n    name: \"Idle\",\n    when: () => true,\n    run: () => console.log(\"idle\")\n  }\n], {\n  state: {\n    pv: START_PV,\n  },\n  join: { gamemode: GAMEMODE, login: true },\n  options: { username: USERNAME },\n}).onFinish(() => {\n  console.log(\"Finished!\")\n  script.stop()\n}).start()\n"},"format":"jnbot-plugin","info":{"_id":{},"config":[{"collapsed":false,"name":"General","options":[{"id":"username","label":"Username","required":true,"type":"altSelect"},{"defaultValue":1,"id":"startPv","inputType":"number","label":"Start pv","required":true,"type":"input"},{"id":"gamemode","label":"Gamemode","required":true,"type":"gamemodeSelect"}]},{"collapsed":true,"name":"Custom","options":[{"defaultValue":"12","id":"clickGiftSlotId","inputType":"text","label":"Click Gift Slot Id","required":true,"type":"input"},{"defaultValue":"1","id":"leastEmptySlots","inputType":"number","label":"Least required empty slots before putting in pv","required":true,"type":"input"}]}],"createdAt":1782330098081,"description":"Collects your gifts and puts them into our pv","editedAt":null,"language":"js","name":"giftCollector","pluginId":"giftCollector","public":false,"scriptType":"script","theme":{"accentColor":"#2193b0","gradientEnd":"#6dd5ed","gradientStart":"#2193b0","primaryColor":"#2193b0","secondaryColor":"#6dd5ed","tagColor":"#6dd5ed"}},"signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"usserwout","signedAt":"2026-09-03T13:32:51.664Z","value":"tw-smWLkyBUbtCvph_GPUBuF1ZPkWkEVzrA1EUxbADWk9SauS5e-1gLl79eKpGvKSvYLt3_5gzq2rUE7IqyDAA"},"version":2}
