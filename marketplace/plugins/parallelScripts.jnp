{"code":{"code":"\nconst { script } = require('jnbot');\n\n\nconst IS_ACTION = {\n    \"mpojb0gpxnn024s3i2\": true, // gkit collector\n    \"mpqqzf5mlsgzkgxyk7d\": true, // kit collector\n    \"mpzrm06ip0gdg9gfgcj\": true, // gkit upgrader\n    \"mpzsqqe8aauyhkmpd15\": false // alt scanner\n}\n\n\nasync function main() {\n\n     if(!script.appVersion.isLaterThan(\"3.0.7\")) {\n         console.error(\"You're on an outdated app version, please update the app.\")\n         script.stop()\n         return \n     } \n\n\n    const options = script.settings\n    const pluginId = options.pluginId\n\n    if (!(pluginId in IS_ACTION)) {\n        console.warn(\"Plugin ID is not nativly supported for this plugin. It's not clear whether it's an action or plugin. Defaulting to script\")\n    }\n    const allAlts = script.getAlts()\n    const alts = await Array.fromAsync(script.forEachAlt(allAlts, script.settings))\n\n\n    const ignoredAlts = allAlts.filter((alt) => !alts.some((a) => a.username === alt.username)).map(e => e.username)\n\n\n\n\n    if (IS_ACTION[options.pluginId]) {\n        await runActions(alts, options)\n    } else {\n        runScripts(alts, options, ignoredAlts)\n        console.success(\"Started \" + options.instances + \" scripts!\")\n    }\n\n    script.stop()\n}\n\n\nasync function runActions(alts, options) {\n    let altIdx = { current: 0 }\n    let promisses = []\n\n    for (let i = 0; i < options.instances; i++) {\n        promisses.push(runAction(alts, options, altIdx))\n    }\n\n\n    await Promise.allSettled(promisses)\n}\n\nasync function runAction(alts, options, altIdx) {\n\n\n    while (altIdx.current < alts.length) {\n        for await (const bot of script.forEachBot([alts[altIdx.current++]], {}, { disableUIControls: true, join: { gamemode: options.gamemode, login: true } })) {\n            script.updateProgress({\n                current: altIdx.current,\n                total: alts.length\n            })\n\n            await script.startAction({\n                actionId: options.pluginId,\n                bot,\n            })\n        }\n    }\n\n}\n\nfunction runScripts(alts, options, ignoredAlts) {\n    const partitionSize = Math.ceil(alts.length / options.instances)\n\n    for (let i = 0; i < options.instances; i++) {\n        const altPartition = alts.slice(i * partitionSize, partitionSize * (i + 1))\n\n        script.startPlugin({\n            pluginId: options.pluginId,\n            optionOverrides: {\n                ...options,\n                ignoreAlts: [...ignoredAlts, ...altPartition.map(e => e.username)],\n            }\n        })\n\n    }\n\n}\n\nmain()"},"format":"jnbot-plugin","info":{"_id":{},"banner":"https://i.ibb.co/SwK3VGcs/parallel-Scripts-Banner.webp","config":[{"collapsed":false,"name":"General","options":[{"freeSolo":true,"id":"pluginId","label":"plugin","options":[{"label":"Gkit collector","value":"mpojb0gpxnn024s3i2"},{"label":"Kit collector","value":"mpqqzf5mlsgzkgxyk7d"},{"label":"Alt scanner","value":"mpzsqqe8aauyhkmpd15"},{"label":"Gkit upgrader","value":"mpzrm06ip0gdg9gfgcj"}],"required":true,"type":"select"},{"defaultValue":2,"id":"instances","label":"Amount of instances","max":7,"min":1,"required":true,"step":1,"type":"slider"},{"id":"gamemode","label":"Gamemode","required":true,"type":"gamemodeSelect"}]},{"collapsed":true,"name":"Alts","options":[{"id":"ignoreAlts","label":"Skip alts","type":"altsSelect","valueByFieldId":"gamemode"},{"id":"altRange","label":"Alt range","type":"altRange","valueByFieldId":"gamemode"},{"id":"withTags","label":"Alt groups","type":"tagsSelect","valueByFieldId":"gamemode"},{"defaultValue":false,"id":"withRanks","label":"Skip alts with no ranks","type":"switch","valueByFieldId":"gamemode"},{"defaultValue":false,"id":"withGkits","label":"Skip alts with no gkits","type":"switch","valueByFieldId":"gamemode"}]}],"createdAt":1782829751883,"description":"Script runs too slow? Run multiple instances of the same script or action in parallel.","editedAt":null,"language":"js","name":"Parallel scripts","pluginId":"parallelScripts","public":false,"scriptType":"script","theme":{"accentColor":"#2193b0","gradientEnd":"#6dd5ed","gradientStart":"#2193b0","primaryColor":"#2193b0","secondaryColor":"#6dd5ed","tagColor":"#6dd5ed"},"userID":"40179c160fc4d12b5490a3d048d471f50b25946dd40a019fdb15f2bf7512ff30"},"signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"usserwout","signedAt":"2026-09-03T13:32:51.667Z","value":"MscopVSJ3f8PvOO1db8OG4gsdjrr7cwUb_5LIB0K1B-R0bn5UH4C4oy2fdHPCKHsbCgweLr3dhcwCkRPevz0Dw"},"version":2}
