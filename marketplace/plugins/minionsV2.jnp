{"code":{"code":"\n/**\n * This script tracks your (SkyblockDream) minions activity. \n * In this version the minions are no longer required to only mine the block below itself.\n * This script detect the full minion range.\n * \n * To use this script, change the 'USERNAME' and 'DISCORD_WEBHOOK' variables\n */\n\nconst axios = require(\"axios\")\n\nconst USERNAME = \"Zola\"  // The alt that will check your minions, make sure this alt is close your minions\nconst DISCORD_WEBHOOK =\"https://discord.com/api/webhooks/xxxx/xxxxxxxx\" // The discord webhook url, if you don't know how to get this watch: https://www.youtube.com/watch?v=K8vgRWZnSZw\nconst MAX_RANGE = 30 // distance the bot will detect minions\n\nlet totalBlockCount = 0\nlet blockCount = 0\nlet activeCount = 0\nlet minionCount = {}\n\nmain()\nasync function main() {\n  const bot = await join({ username: USERNAME },{login:true, gamemode:\"sbd\",  retryOnLoginFail: true, retryOnGamemodeStuck: true,})\n  console.log(`Joined ${bot.currentGamemode}!`)\n  await bot.waitForTicks(15)\n  try {\n    const pos = bot.entity.position\n    const minions = Object.values(bot.entities).filter((entity) => entity.mobType === \"Armor Stand\" && pos.distanceTo(entity.position) < MAX_RANGE)\n    let positions = minions.map((m) => m.position.toString())\n    send(`**${positions.length} minions found**: ${positions.join(\" \\t \")}`)\n    let workingMinions = new Set(positions)\n    bot.on(\"blockBreakProgressEnd\", (block) => {\n      try {\n        const minion = minions.find((m) => m.position.y === block.position.y + 1 && block.position.manhattanDistanceTo(m.position) <= 3)\n        if (minion) {\n          totalBlockCount++\n          blockCount++\n          let str = minion.position.toString()\n          workingMinions.delete(str)\n          minionCount[str] ??= 0\n          minionCount[str]++\n        }\n      } catch (err) {\n        console.log(err)\n      }\n    })\n\n    let interval = setInterval(() => {\n      try {\n        if (workingMinions.size > 0) {\n          send(`**[ALERT]:** @here **${workingMinions.size} of the ${positions.length} minions aren't mining!** (${[...workingMinions].join(\" \\t \")})`)\n        }\n        activeCount++\n        let minionData = []\n        let avg = Math.round(totalBlockCount / activeCount)\n        for (let [key, value] of Object.entries(minionCount).sort((a, b) => b[1] - a[1])) {\n          let a = Math.round(value - avg / positions.length)\n          minionData.push(`Minion at \\`${key}\\`: mined ${value} blocks. That's ${a === 0 ? \" the average amount.\" : a > 0 ? a + \" above average.\" : Math.abs(a) + \" below average.\"} `)\n        }\n        sendStats({\n          general: `Blocked mined in last minute: **${blockCount} blocks**\\nTotal block mined: **${totalBlockCount} blocks**.\\nActive for: **${activeCount} minutes**.\\naverage of **${Math.round(avg)} blocks / minute**\\nping: **${bot.player.ping}**`,\n          minion: minionData.slice(0, 7).join(\"\\n\"),\n          minion2: minionData.slice(7).join(\"\\n\"),\n        })\n        minionCount = {}\n        workingMinions = new Set(positions)\n        blockCount = 0\n      } catch (err) {\n        console.log(err)\n      }\n    }, 60000) // Send minion information every minute\n\n    bot.once(\"end\", () => {\n      clearInterval(interval)\n      setTimeout(main, 10000)\n    })\n    bot.once(\"kicked\", (e) => {\n      clearInterval(interval)\n      console.log(e)\n      bot?.end()\n    })\n  } catch (e) {\n    console.log(e)\n  }\n}\n\nasync function sendStats({ general, minion, minion2 }) {\n  const fields = [\n    {\n      name: `General`,\n      value: general || \"\",\n    },\n    {\n      name: `Minion 1-7 stats`,\n      value: minion || \"\",\n    },\n  ]\n  if (minion2) {\n    fields.push({\n      name: `Minion 8-14 stats`,\n      value: minion2,\n    })\n  }\n\n  try {\n    const config = {\n      method: \"POST\",\n      url: DISCORD_WEBHOOK,\n      headers: { \"Content-Type\": \"application/json\" },\n      data: JSON.stringify({\n        content: \"\",\n        username: \"Minion Stats\",\n        embeds: [\n          {\n            title: `Stats`,\n            description: \"\",\n            color: 0x00ffff,\n            fields,\n            footer: {\n              text: `JNbot - Minion checker`,\n            },\n          },\n        ],\n      }),\n    }\n\n    await axios(config)\n  } catch (err) {\n\n   }\n}\n\nasync function send(message) {\n  console.log(message)\n  const config = {\n    method: \"POST\",\n    url: DISCORD_WEBHOOK,\n    headers: { \"Content-Type\": \"application/json\" },\n    data: JSON.stringify({ content: message,username:\"Minion alert\" }),\n  }\n  await axios(config)\n}\n"},"format":"jnbot-plugin","info":{"_id":{},"createdAt":1657739990110,"description":"Alerts you when minions are full and provides you detailed information.","editedAt":null,"flags":4,"language":"js","name":"minion-checkerV2","pluginId":"minionsV2","privateKey":"3m4suiype6xd8e2d7h278caaxb8e2joprqu9lrzrczw","public":false,"publicKey":"minionsV2","type":"verified","uploadedAt":1657739990110,"userID":"40179c160fc4d12b5490a3d048d471f50b25946dd40a019fdb15f2bf7512ff30"},"signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"usserwout","signedAt":"2026-09-03T13:32:51.666Z","value":"1sJtcJYsiMsE7zrNdOQAcBbIlllTCTqQDGaQY_bdQ0WWbAuVpX9k5eAG6HAl7Rd592Q-2IWO9rG3hOXRan-JBQ"},"version":2}
