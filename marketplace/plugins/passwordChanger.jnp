{"code":{"code":"const { script } = require(\"jnbot\")\n\nconst options = script.settings\n\nasync function changePassword(bot) {\n\n  await bot.waitForTicks(20)\n\n  const password = await script.requestAccountPassword(bot.username)\n  if (!password) {\n    console.log(\"Skipping \" + bot.username)\n    return\n  }\n\n\n  const command = options.command.replaceAll(\"[oldPassword]\", password)\n\n  bot.chat(command)\n  await bot.waitForTicks(20)\n\n}\n\n\n\nasync function main() {\n\n  if (!options.command.includes(\"[newPassword]\")) {\n    script.optionError({ field: \"command\", message: \"The command must include the string '[newPassword]'. This auto gets replaced with the right value.\" })\n    script.stop()\n  }\n\n  if (!options.command.startsWith(\"/\")) {\n    script.optionError({ field: \"command\", message: \"The command must start with /\" })\n    script.stop()\n  }\n\n  if (options.newPassword.includes(\" \")) {\n    script.optionError({ field: \"newPassword\", message: \"Password cannot contain spaces\" })\n    script.stop()\n  }\n\n  options.command = options.command.replaceAll(\"[newPassword]\", options.newPassword)\n\n  let changedPasswords = {}\n  let hasRequested = false\n  script.onExit(() => {\n    if (hasRequested) return\n\n    script.requestAltUpdate(changedPasswords)\n    hasRequested = true\n  })\n\n  for await (const bot of script.forEachBot(script.getAlts(), options, { showProgress: true })) {\n    console.log(\"Joined with \" + bot.username)\n    await changePassword(bot)\n    changedPasswords[bot.username] = { password: options.newPassword }\n    console.log(\"Finished joining with \" + bot.username)\n  }\n\n  if (!hasRequested) {\n    script.requestAltUpdate(changedPasswords)\n    hasRequested = true\n  }\n  script.stop()\n}\n\n\nmain()"},"format":"jnbot-plugin","info":{"_id":{},"banner":"https://i.ibb.co/HTw6P8wc/password-Changer.png","config":[{"collapsed":false,"name":"General","options":[{"id":"newPassword","inputType":"password","label":"New password","required":true,"type":"input"},{"defaultValue":"/cp [oldPassword] [newPassword] [newPassword]","id":"command","inputType":"text","label":"Command","required":true,"tooltip":"The command the bot uses to change the passwords. '[oldPassword]', '[newPassword]' automatically get replaced by the right values, so you do not need to replace this.","type":"input"}]},{"collapsed":true,"name":"Alts","options":[{"id":"altRange","label":"Alt range","type":"altRange"},{"id":"ignoreAlts","label":"Skip alts","type":"altsSelect"},{"id":"withTags","label":"Alt group","type":"tagsSelect"}]}],"createdAt":1782200638077,"description":"Updates your alts passwords ingame and updates them in the app. ","editedAt":null,"language":"js","name":"Password Changer","pluginId":"passwordChanger","public":false,"scriptType":"script","theme":{"accentColor":"#2193b0","gradientEnd":"#6dd5ed","gradientStart":"#2193b0","primaryColor":"#2193b0","secondaryColor":"#6dd5ed","tagColor":"#6dd5ed"}},"signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"usserwout","signedAt":"2026-09-03T13:32:51.668Z","value":"gxnuzVCL74iEF0ZB3REBbKZmX5Ms6RB4L1TICyvEhpThR2IMAMSzSFNQo0QDTpFteh07iBneoIFjz0QlMWHYCg"},"version":2}
