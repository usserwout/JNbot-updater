{"code":{"code":"\nconst { script, BotMachine } = require(\"jnbot\")\n\nasync function main(bot, options) {\n\n  if (!Array.isArray(options.commands) || !options.commands.length) {\n    script.optionError({\n      field: \"commands\",\n      message: \"You must have at least one command\"\n    })\n    return script.stop()\n  }\n\n  return new Promise((resolve) => {\n    new BotMachine([\n      {\n        name: \"Run command\",\n        when: ({state}) => state.commandCounter < options.commands.length,\n        run: async ({ bot, state }) => {\n          const command = options.commands[state.commandCounter]\n          state.commandCounter++\n          if (!command.command) {\n            script.optionError({\n              field: \"commands\",\n              message: \"The command field should not be empty\"\n            })\n            return script.stop()\n          }\n          if (command.slotId < 0 || typeof command.slotId !== \"number\") {\n            console.log(`Running ${command.command}`)\n            bot.chat(command.command)\n          } else {\n            console.log(`Running ${command.command} and clicking on ${command.slotId}`)\n\n            await bot.openWindow(command.command)\n\n            if (bot.currentWindow) {\n              if (bot.currentWindow.slots[command.slotId] === null) {\n                console.warn(\"Window opened but clicking on empty slot\")\n              }\n              bot.clickWindow(command.slotId, 0, 0)\n              await bot.waitForTicks(10)\n              if (bot.currentWindow) {\n                bot.closeWindow(bot.currentWindow)\n              }\n            } else {\n              console.warn(\"No window has opened\")\n            }\n          }\n          await bot.waitForTicks(10)\n        }\n      },\n      {\n        name: \"Finishing\",\n        when: () => true,\n        run: ({machine}) => machine.stop() \n      }\n    ], {\n      bot,\n      state: {\n        commandCounter: 0\n      },\n      join: { login: true, gamemode: options.gamemode },\n      joinOptions: bot.alt,\n    }).start().onFinish(() => {\n      resolve()\n    })\n  })\n\n\n\n}\n"},"format":"jnbot-plugin","info":{"banner":"https://i.ibb.co/bj6mXFMz/command-Runner.png","config":[{"collapsed":false,"name":"General","options":[{"id":"gamemode","label":"Gamemode","required":true,"type":"gamemodeSelect"},{"addLabel":"Add command","fields":[{"inputType":"text","key":"command","label":"Command","placeholder":"/clearinventory","type":"input"},{"inputType":"number","key":"slotId","label":"Window click","placeholder":"[optional] Slot id to click on","type":"input"}],"id":"commands","label":"Commands","minItems":1,"required":true,"tooltip":"The bot will run these commands one after another. The window click option is optional for when the command opens up a window (such as /ci) and the bot has to click on a specific slot. Leave it blank when no window opens.","type":"list","valueByFieldId":"gamemode"}]},{"collapsed":true,"name":"Alts","options":[{"id":"altRange","label":"Alt range","type":"altRange","valueByFieldId":"gamemode"},{"id":"ignoreAlts","label":"Skip alts","type":"altsSelect"},{"id":"withTags","label":"Alt group","type":"tagsSelect","valueByFieldId":"gamemode"},{"defaultValue":false,"id":"withRanks","label":"Alt with ranks only","type":"switch"},{"defaultValue":false,"id":"withGkits","label":"Alts with gkits only","type":"switch","valueByFieldId":"gamemode"}]},{"collapsed":true,"name":"Advanced","options":[{"defaultValue":true,"id":"chunkLoadLimit","label":"Optimized chunk loading","type":"switch"}]}],"createdAt":1790092060308,"description":"Loops over your alts and runs a specified command. ","editedAt":null,"language":"js","name":"Run commands","pluginId":"muculdp080v3f9a8pv8","public":false,"scriptType":"action","theme":{"accentColor":"#2193b0","gradientEnd":"#6dd5ed","gradientStart":"#2193b0","primaryColor":"#2193b0","secondaryColor":"#6dd5ed","tagColor":"#6dd5ed"}},"signature":{"algorithm":"ed25519","publicKey":"MCowBQYDK2VwAyEAHpiP3IOzZr3aDZi2-e5t8bwO6KrWuZUHyyqla6Y3XHA","publisherName":"usserwout","signedAt":"2026-09-22T17:13:18.880Z","value":"6uVX6JFtR2kDAcvmTUBIoTJwt7G_Fj2SFJn70d-40syrKOgABf53M7vFOO20eFhS_NZFGi8MBsOzjTY0hF5ABg"},"version":2}
